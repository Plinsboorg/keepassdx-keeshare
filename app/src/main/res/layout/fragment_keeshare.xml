<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:padding="@dimen/default_margin"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="noExcludeDescendants"
        tools:targetApi="o">

        <TextView
            android:id="@+id/keeshare_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keeshare"
            style="@style/KeepassDXStyle.Title"/>

        <RadioGroup
            android:id="@+id/keeshare_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/keeshare_type_synchronize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keeshare_type_synchronize" />
            <RadioButton
                android:id="@+id/keeshare_type_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keeshare_type_import" />
            <RadioButton
                android:id="@+id/keeshare_type_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keeshare_type_export" />
        </RadioGroup>

        <TextView
            android:id="@+id/keeshare_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/keeshare_no_file"
            style="@style/KeepassDXStyle.SubTitle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/keeshare_choose_file"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:text="@string/keeshare_choose_file"
                style="@style/KeepassDXStyle.Button.Secondary"/>
            <Button
                android:id="@+id/keeshare_new_file"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:text="@string/keeshare_new_file"
                style="@style/KeepassDXStyle.Button.Secondary"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/keeshare_password_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/keeshare_password"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/keeshare_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/keeshare_keep_groups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/keeshare_keep_groups" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/keeshare_explanation"
            style="@style/KeepassDXStyle.Text.Preferences.Explanation"/>
    </LinearLayout>
</ScrollView>
